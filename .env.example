# 应用配置复制到不提交的 .env.local。测试进程使用不提交的 .env.test。
# Compose 密码放在不提交的 .env.compose。本文件只保留占位符，不能写入真实密码或密钥。
# Mailpit 只在本机收集测试邮件，不转发到外部邮箱。

APP_ENV=local
APP_URL=http://127.0.0.1:3000
AUTH_SECRET=
DATABASE_URL=postgresql://baby_plan_dev:replace-me@127.0.0.1:5432/baby_plan_dev
MAIL_TRANSPORT=smtp
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
MAILPIT_URL=http://127.0.0.1:8025

# .env.test 使用另一组占位符：
# APP_ENV=test
# APP_URL=http://127.0.0.1:3000
# AUTH_SECRET=
# DATABASE_URL=postgresql://baby_plan_test:replace-me@127.0.0.1:5433/baby_plan_test
# MAIL_TRANSPORT=smtp
# SMTP_HOST=127.0.0.1
# SMTP_PORT=1025
# MAILPIT_URL=http://127.0.0.1:8025

# .env.compose 只放 Compose 变量：
# POSTGRES_DEV_PASSWORD=
# POSTGRES_TEST_PASSWORD=

# 生产环境要求 APP_ENV=production、HTTPS、PostgreSQL，以及非本机回环地址的邮件传输。
# 真实邮件发送尚未实现。本机 Mailpit 不能当作生产投递。

# B3：所有真实外部服务默认关闭。填入已有账号配置与明确日用量上限后才会调用。
# 不在 NEXT_PUBLIC_* 中存放凭据；更改后重启 Web 与 worker。
# 和风天气：仅填控制台 API Host 域名；优先完整 Ed25519 JWT，亦支持已有 API KEY。
QWEATHER_API_HOST=
QWEATHER_KEY_ID=
QWEATHER_DEVELOPER_ID=
QWEATHER_PROJECT_ID=
# PEM 换行可写成字面量 \n；私钥仅留在服务器环境。
QWEATHER_PRIVATE_KEY=
QWEATHER_API_KEY=
# 每次刷新会分别请求 current 与 hourly，通常消耗 2 次请求。
WEATHER_DAILY_REQUEST_LIMIT=0

# 自家接入选用 DeepSeek V4.1 Flash：AI_PROVIDER=deepseek、AI_MODEL=deepseek-flash。
# 官方入口 AI_BASE_URL=https://api.deepseek.com；AI_REGION 可标记“官方 API（未指定地域）”，不推定物理地域。
# 本文件仍保持关闭；真实密钥与用量上限只写入不提交的服务端配置。
# 适配 /chat/completions + JSON Output + usage 字段；实际供应商须单独联调。
# BASE_URL 为不带 /chat/completions 的 HTTPS 根地址（需要 /v1 时自行保留）。
AI_PROVIDER=
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_REGION=
AI_DAILY_REQUEST_LIMIT=0
AI_DAILY_TOKEN_LIMIT=0
AI_MAX_OUTPUT_TOKENS=4000
# 本机一周菜单联调设为 16000，以容纳完整草案；日 token 上限仍单独控制。
AI_MAX_INPUT_BYTES=48000
AI_TIMEOUT_MS=60000
# 仅 DeepSeek 使用此字段；明确关闭默认思考模式，保留输出预算给最终 JSON。
AI_THINKING_MODE=disabled
SERVICE_TIMEOUT_MS=10000
# 日限额统一按 UTC 日计；未知 token 用量保留预留。费用保持未知，以供应商账单为准。
# 测试 HTTP 服务仅在 APP_ENV=test 且 loopback 可用；不要写进 .env.local。
# B3_TEST_WEATHER_URL=http://127.0.0.1:TEST_PORT
